+static void kc_battery_report(uint8_t *data) {
+    uint16_t voltage = battery_get_voltage();
+    data[0] = KC_GET_BATTERY;
+    data[1] = battery_get_percentage();
+    data[2] = voltage & 0xFF;
+    data[3] = voltage >> 8;
